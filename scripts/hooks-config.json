{
  "_comment": "Hook 配置片段示例。timeout 单位是秒；命令以 bash 开头即可，不要写 bash.exe 的绝对路径；完整的全局配置见 hooks/hooks.json。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/your-script.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/your-script.sh\""
          }
        ]
      }
    ]
  }
}
