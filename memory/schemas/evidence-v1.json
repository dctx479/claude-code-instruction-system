{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence metadata v1",
  "type": "object",
  "required": [
    "confidence",
    "evidence"
  ],
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "method",
          "confidence",
          "date",
          "verified_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "test",
              "commit",
              "measurement",
              "observation",
              "documentation"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "object"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
